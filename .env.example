# drop.js environment configuration
# Copy to .env and modify as needed

# Server
PORT=3000
NODE_ENV=development

# Database (SQLite default — override for MySQL/PostgreSQL/Supabase)
# DB_CLIENT=mysql2
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=
# DB_NAME=dropjs
# DB_SSL=1                   # Enable SSL (required for Supabase and most cloud PostgreSQL)

# Supabase / PostgreSQL connection string (alternative to individual DB_* vars)
# DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# Session security
# SESSION_SECRET=          # HMAC secret for signing session tokens (auto-generated if unset)

# Data & uploads
# DROP_DATA_DIR=./data
# UPLOADS_DIR=data/files

# Admin UI
# DROP_NO_ADMIN=1        # Set to disable admin UI (API-only mode)

# Rate limiting
# DROP_DISABLE_RATE_LIMIT=1   # Disable rate limiting (for testing)

# Email (SMTP)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=noreply@example.com

# Site
# SITE_URL=http://localhost:3000   # Used in email links
# SITE_EMAIL=admin@example.com     # Contact form notifications sent here

# Logging
# LOG_LEVEL=info         # debug, info, warn, error
