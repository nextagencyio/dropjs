{
  "name": "dropjs",
  "version": "0.1.0",
  "description": "A Node.js CMS framework inspired by Drupal",
  "type": "module",
  "license": "ISC",
  "main": "dist/core/index.js",
  "types": "dist/core/index.d.ts",
  "exports": {
    ".": "./dist/core/index.js",
    "./api": "./dist/api/index.js",
    "./auth": "./dist/auth/index.js",
    "./db": "./dist/db/index.js",
    "./field": "./dist/field/index.js"
  },
  "bin": {
    "drop": "dist/bin/drop.js"
  },
  "files": [
    "dist/",
    "config/",
    "themes/",
    "src/app/",
    "src/components/",
    "src/lib/",
    "next.config.ts",
    "postcss.config.mjs",
    "tsconfig.json",
    "public/",
    "README.md"
  ],
  "scripts": {
    "dev": "npx tsx src/cli/commands/dev.ts",
    "build": "tsc -p tsconfig.server.json && next build",
    "build:server": "tsc -p tsconfig.server.json",
    "build:admin": "next build",
    "start": "node dist/cli/commands/dev.js",
    "serve": "node dist/cli/commands/serve.js",
    "drop": "node dist/bin/drop.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "typecheck": "tsc -p tsconfig.server.json --noEmit",
    "clean": "rm -rf dist .next"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@graphql-tools/schema": "^10.0.31",
    "@tiptap/extension-code-block": "^3.19.0",
    "@tiptap/extension-link": "^3.19.0",
    "@tiptap/pm": "^3.19.0",
    "@tiptap/react": "^3.19.0",
    "@tiptap/starter-kit": "^3.19.0",
    "bcryptjs": "^2.4.3",
    "chalk": "^5.3.0",
    "commander": "^12.0.0",
    "dotenv": "^17.3.1",
    "graphql": "^16.12.0",
    "js-yaml": "^4.1.1",
    "knex": "^3.1.0",
    "lucide-react": "^0.575.0",
    "mysql2": "^3.17.0",
    "next": "^15.3.3",
    "nodemailer": "^8.0.1",
    "php-serialize": "^5.1.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sharp": "^0.34.5",
    "sqlite3": "^5.1.0",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4.1.8",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^4.17.21",
    "@types/js-yaml": "^4.0.9",
    "@types/multer": "^2.0.0",
    "@types/node": "^25.2.3",
    "@types/nodemailer": "^7.0.11",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/supertest": "^6.0.3",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/uuid": "^10.0.0",
    "cookie-parser": "^1.4.7",
    "express": "^4.21.0",
    "helmet": "^8.1.0",
    "multer": "^2.0.2",
    "raw-body": "^3.0.2",
    "supertest": "^7.2.2",
    "swagger-ui-express": "^5.0.1",
    "tailwindcss": "^4.1.8",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
