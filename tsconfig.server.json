{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": "src"
  },
  "include": [
    "src/api/**/*.ts",
    "src/auth/**/*.ts",
    "src/bin/**/*.ts",
    "src/cli/**/*.ts",
    "src/core/**/*.ts",
    "src/db/**/*.ts",
    "src/field/**/*.ts",
    "src/migrate/**/*.ts"
  ],
  "exclude": ["node_modules", "dist", "**/*.test.ts"]
}
